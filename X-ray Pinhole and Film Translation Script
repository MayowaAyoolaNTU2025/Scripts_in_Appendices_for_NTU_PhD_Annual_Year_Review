function [x, y, rowIdx] = generateHexGridPoints(faceRadius_mm, spacing_mm)
% Hexagonal (honeycomb) grid: alternate rows offset by spacing/2, row
% height spacing*sqrt(3)/2 -- the standard hex close-packed construction.
% Keeps candidate points whose centre lies within faceRadius_mm.
    rowHeight = spacing_mm * sqrt(3) / 2;
    nRowsHalf = ceil(faceRadius_mm / rowHeight) + 1;
    x = zeros(0, 1); y = zeros(0, 1); rowIdx = zeros(0, 1);
    for r = -nRowsHalf:nRowsHalf
        yv = r * rowHeight;
        if abs(yv) > faceRadius_mm, continue; end
        xOffset = mod(abs(r), 2) * (spacing_mm / 2);
        nColsHalf = ceil(faceRadius_mm / spacing_mm) + 2;
        for c = -nColsHalf:nColsHalf
            xv = c * spacing_mm + xOffset;
            if xv^2 + yv^2 <= faceRadius_mm^2
                x(end+1, 1) = xv; y(end+1, 1) = yv; rowIdx(end+1, 1) = r; %#ok<AGROW>
            end
        end
    end
end

function order = spiralOrderIndices(x, y)
% Sort by increasing radius then angle -> approximate centre-outward
% spiral (radial+angular sort, not a strict hex-ring spiral, but simple
% and gives the desired centre-out behaviour).
    radius = sqrt(x.^2 + y.^2);
    theta = atan2(y, x);
    theta(theta < 0) = theta(theta < 0) + 2*pi;
    [~, order] = sortrows([radius, theta]);
end

function order = rasterOrderIndices(x, y, rowIdx)
% Row by row using the hex-grid row index, alternating sweep direction
% each row (serpentine/boustrophedon) to minimise travel distance.
    uniqueRows = sort(unique(rowIdx));
    order = zeros(0, 1);
    goingRight = true;
    for k = 1:numel(uniqueRows)
        idxInRow = find(rowIdx == uniqueRows(k));
        [~, sortIdx] = sort(x(idxInRow));
        if ~goingRight, sortIdx = flipud(sortIdx(:)); end
        order = [order; idxInRow(sortIdx)]; %#ok<AGROW>
        goingRight = ~goingRight;
    end
end

function [spotX, spotY, spotRowLabel, spotColLabel, nRows, nCols] = ...
    buildFilmSpotGrid(filmWidth_mm, filmHeight_mm, spotSize_mm, spotGap_mm, edgeMargin_mm, filmShape, filmDiameter_mm, filmStartCorner)
% Regular grid of square exposure spots, pitch = spotSize+spotGap, kept
% edgeMargin_mm from the sheet edge. For 'circular' film, candidate spots
% whose square footprint would cross the circular boundary are dropped.
%
% spotRowLabel/spotColLabel always number rows bottom-to-top and columns
% left-to-right (a fixed physical reference), but filmStartCorner controls
% the ORDER the two nested loops below visit them in, which is what
% decides which physical spot ends up being spot #1 (the very first one
% the scan uses on every sheet) -- e.g. 'top-right' visits the top row
% first, right-to-left, so the top-right spot becomes spot #1.
    pitch = spotSize_mm + spotGap_mm;
    usableWidth  = filmWidth_mm  - 2*edgeMargin_mm;
    usableHeight = filmHeight_mm - 2*edgeMargin_mm;
    nCols = floor((usableWidth  - spotSize_mm) / pitch) + 1;
    nRows = floor((usableHeight - spotSize_mm) / pitch) + 1;
    if nCols < 1 || nRows < 1
        error('Film too small for the requested spot size / gap / margin.');
    end
    colPos = linspace(-(nCols-1)*pitch/2, (nCols-1)*pitch/2, nCols);  % left(-) to right(+)
    rowPos = linspace(-(nRows-1)*pitch/2, (nRows-1)*pitch/2, nRows);  % bottom(-) to top(+)

    switch lower(filmStartCorner)
        case 'bottom-left',  rowOrder = 1:nRows;      colOrder = 1:nCols;
        case 'bottom-right', rowOrder = 1:nRows;      colOrder = nCols:-1:1;
        case 'top-left',     rowOrder = nRows:-1:1;    colOrder = 1:nCols;
        case 'top-right',    rowOrder = nRows:-1:1;    colOrder = nCols:-1:1;
        otherwise
            error('filmStartCorner must be ''bottom-left'', ''bottom-right'', ''top-left'' or ''top-right''.');
    end

    spotX = zeros(0,1); spotY = zeros(0,1); spotRowLabel = zeros(0,1); spotColLabel = zeros(0,1);
    cornerReach = spotSize_mm * sqrt(2) / 2;   % half-diagonal of a square spot
    filmRadius = filmDiameter_mm/2 - edgeMargin_mm;
    for rr = rowOrder
        for cc = colOrder
            candX = colPos(cc); candY = rowPos(rr);
            keepPoint = true;
            if strcmpi(filmShape, 'circular')
                keepPoint = (sqrt(candX^2 + candY^2) + cornerReach) <= filmRadius;
            end
            if keepPoint
                spotX(end+1,1) = candX; spotY(end+1,1) = candY; %#ok<AGROW>
                spotRowLabel(end+1,1) = rr; spotColLabel(end+1,1) = cc; %#ok<AGROW>
            end
        end
    end
    if isempty(spotX)
        error('No film spots survived circular-film clipping -- check filmDiameter_mm / edgeMargin_mm / spotSize_mm.');
    end
end

function plotCircleLocal(cx, cy, r, rgbColor, lineWidth)
% Draws a circle with plain `plot` (core MATLAB) so no Image Processing
% Toolbox / viscircles is required.
    theta = linspace(0, 2*pi, 60);
    plot(cx + r.*cos(theta), cy + r.*sin(theta), '-', 'Color', rgbColor, 'LineWidth', lineWidth);
end

function checkStageRange(stageName, targets_mm, lo_mm, hi_mm, pointID)
% Warns (never silently clips) if any target falls outside stage travel.
    badIdx = find(targets_mm < lo_mm | targets_mm > hi_mm);
    if ~isempty(badIdx)
        warning('%s: %d point(s) outside [%.1f, %.1f] mm. First: %s (%.3f mm).', ...
            stageName, numel(badIdx), lo_mm, hi_mm, pointID{badIdx(1)}, targets_mm(badIdx(1)));
    end
end

function printPointExample(resultsTable, k)
% Human-readable per-stage printout for one row, e.g. "NRT stage 1 moves
% to this; NRT stage 2 moves to that; ..."
    row = resultsTable(k, :);
    fprintf('--- Example: %s (scan order index %d) ---\n', row.PointID{1}, row.ScanOrderIndex);
    fprintf('   Pinhole offset : (%.3f, %.3f) mm\n', row.Pinhole_X_mm, row.Pinhole_Y_mm);
    fprintf('   Film sheet/spot: sheet %d, spot #%d (row %d, col %d)\n', row.FilmNumber, row.SpotIndexInFilm, row.SpotRow, row.SpotCol);
    fprintf('   NRT stage 1 (pinhole X) : %s to %.4f mm\n', ternaryStr(row.NRT_StageX_moves, 'MOVES', 'stays'), row.NRT_StageX_target_mm);
    fprintf('   NRT stage 2 (pinhole Y) : %s to %.4f mm\n', ternaryStr(row.NRT_StageY_moves, 'MOVES', 'stays'), row.NRT_StageY_target_mm);
    fprintf('   LTS stage 3 (film X)    : %s to %.4f mm\n', ternaryStr(row.LTS_StageX_moves, 'MOVES', 'stays'), row.LTS_StageX_target_mm);
    fprintf('   LTS stage 4 (film Y)    : %s to %.4f mm\n', ternaryStr(row.LTS_StageY_moves, 'MOVES', 'stays'), row.LTS_StageY_target_mm);
    fprintf('   Total stages moving      : %d of 4\n\n', row.NumStagesMoving);
end

function s = ternaryStr(cond, ifTrue, ifFalse)
% MATLAB has no ternary operator; this keeps the fprintf calls readable.
    if cond, s = ifTrue; else, s = ifFalse; end
end

function runCalibrationHelper(pairLabel, stageX, stageY, targetVarNames)
% Interactive one-off helper used by SECTION 14 when RUN_CALIBRATION_HELPER
% = true. It does NOT move anything itself -- you physically jog the given
% pair of already-connected, already-homed stages into alignment yourself
% (using the Kinesis desktop software, or the controller's own hand/jog
% control), by whatever external method tells you the alignment is
% correct (a beam-finder/detector, a fluorescent screen, a symmetric test
% exposure, or -- for the film -- simply the chosen corner of the sheet
% sitting under the beam). Once you are satisfied, this function reads
% back and prints the stage positions Kinesis is reporting at that exact
% moment, so you can copy them into SECTION 1.
    fprintf('\n=== Calibration: %s ===\n', pairLabel);
    fprintf('Jog these two stages by hand (Kinesis software or the controller''s jog control)\n');
    fprintf('until they are physically aligned the way you want.\n');
    input('Press Enter once aligned, to read back the position...', 's');
    % VERIFY: the position-readback call may be named .Position,
    % .DevicePosition, or reached via a GetPosition() method depending on
    % your Kinesis .NET version -- check before relying on this.
    xPos = double(stageX.Position);
    yPos = double(stageY.Position);
    fprintf('Recorded position -> X = %.4f mm , Y = %.4f mm\n', xPos, yPos);
    fprintf('Copy these into %s in SECTION 1.\n\n', targetVarNames);
end


