function [x, y, rowIdx] = generate_hex_grid_points(boundary_radius_mm, spacing_mm)
% Hexagonal (honeycomb) grid: alternate rows offset by spacing/2, row
% height spacing*sqrt(3)/2 -- the standard hex close-packed construction.
% Keeps candidate points whose centre lies within boundary_radius_mm.
    row_height = spacing_mm * sqrt(3) / 2;
    n_rows_half = ceil(boundary_radius_mm / row_height) + 1;
    x = zeros(0, 1); y = zeros(0, 1); rowIdx = zeros(0, 1);
for r = -n_rows_half:n_rows_half
        yv = r * row_height;
if abs(yv) > boundary_radius_mm, continue; end
        x_offset = mod(abs(r), 2) * (spacing_mm / 2);
        n_cols_half = ceil(boundary_radius_mm / spacing_mm) + 2;
for c = -n_cols_half:n_cols_half
            xv = c * spacing_mm + x_offset;
if xv^2 + yv^2 <= boundary_radius_mm^2
                x(end+1, 1) = xv; y(end+1, 1) = yv; rowIdx(end+1, 1) = r; %#ok<AGROW>
end
end
end
end
function order = raster_order_indices(x, y, row_idx)
% Row by row using the hex-grid row index, alternating sweep direction
% each row (serpentine/boustrophedon) to minimise aperture travel.
    unique_rows = sort(unique(row_idx));
    order = zeros(0, 1);
    going_right = true;
for k = 1:numel(unique_rows)
        idx_in_row = find(row_idx == unique_rows(k));
        [~, sort_idx] = sort(x(idx_in_row));
if ~going_right, sort_idx = flipud(sort_idx(:)); end
        order = [order; idx_in_row(sort_idx)]; %#ok<AGROW>
        going_right = ~going_right;
end
end
function order = spiral_order_indices(x, y)
% Sort by increasing radius then angle -> approximate centre-outward
% spiral (radial+angular sort, not a strict hex-ring spiral, but simple
% and gives the desired centre-out behaviour).
    radius = sqrt(x.^2 + y.^2);
    theta = atan2(y, x);
    theta(theta < 0) = theta(theta < 0) + 2*pi;
    [~, order] = sortrows([radius, theta]);
end
 
