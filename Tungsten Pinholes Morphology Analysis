function S = makeNaNStruct()
%MAKENANSTRUCT  Returns a struct with all measurement fields set to NaN.
%               Used as a placeholder when a CSV file cannot be found or
%               read, so the rest of the script can continue running.
    fields = {'Area','Perim','Major','Minor','Circ', ...
              'Feret','MinFeret','AR','Round','Solidity'};
    for f = 1:numel(fields)
        S.(fields{f}) = NaN;
    end
end

function val = extractCol(T, candidates)
%EXTRACTCOL  Searches table T for the first matching column name from the
%            candidates list (to tolerate naming variants such as "Circ."
%            vs "Circ") and returns its numeric values. Returns NaN if no
%            matching column is found.
    val = NaN;
    for k = 1:numel(candidates)
        if any(strcmp(T.Properties.VariableNames, candidates{k}))
            val = T.(candidates{k});
            if isnumeric(val)
                return
            end
        end
    end
end 
