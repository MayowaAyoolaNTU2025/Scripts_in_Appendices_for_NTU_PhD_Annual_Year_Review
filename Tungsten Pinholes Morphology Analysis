% Tungsten Pinholes Morphology Analysis

clc;
clear;
close all;


fprintf(' TUNGSTEN APERTURE ANALYSIS (PER-PARAMETER RANKING) — STARTING\n');


dataFolder  = 'C:\Users\padra\Desktop\NewImageJ Analysis\Results2';

% Hole diameters (mm) — string labels used in file names AND plots
diamLabels  = {'0.05','0.10','0.15','0.20','0.25', ...
                '0.30','0.35','0.40','0.45','0.50'};

% Threshold values used in file names
thresholds  = [80, 100, 120, 140, 160];

nDiam   = numel(diamLabels);   % 10 hole diameters
nThresh = numel(thresholds);   % 5 threshold repeats per diameter

fprintf('Configuration loaded.\n');
fprintf('  Diameters   : %s\n', strjoin(diamLabels,' | '));
fprintf('  Thresholds  : %s\n', num2str(thresholds));
fprintf('  Data folder : %s\n\n', dataFolder);


rawData = cell(nDiam, nThresh);

for d = 1:nDiam
    for t = 1:nThresh
        fname = sprintf('%smm%dThresholding.csv', diamLabels{d}, thresholds(t));
        fpath = fullfile(dataFolder, fname);

        if ~isfile(fpath)
            warning('File not found: %s — filling with NaN.', fpath);
            rawData{d,t} = makeNaNStruct();
            continue
        end

        try
            T = readtable(fpath, 'VariableNamingRule', 'preserve');

            S.Area     = extractCol(T, {'Area'});
            S.Perim    = extractCol(T, {'Perim.','Perim','Perimeter'});
            S.Major    = extractCol(T, {'Major'});
            S.Minor    = extractCol(T, {'Minor'});
            S.Circ     = extractCol(T, {'Circ.','Circ','Circularity'});
            S.Feret    = extractCol(T, {'Feret'});
            S.MinFeret = extractCol(T, {'MinFeret','Min Feret','Minferet'});
            S.AR       = extractCol(T, {'AR','AspectRatio','Aspect Ratio'});
            S.Round    = extractCol(T, {'Round','Roundness'});
            S.Solidity = extractCol(T, {'Solidity'});

            rawData{d,t} = S;
            fprintf('  Read : %s  (%d row(s))\n', fname, height(T));

        catch ME
            warning('Error reading %s: %s', fname, ME.message);
            rawData{d,t} = makeNaNStruct();
        end
    end
end

fprintf('\nAll files processed.\n\n');


fprintf(' SECTION 3 : Computing per-hole statistics \n');

paramNames = {'Area','Perim','Major','Minor','Circ','Feret','MinFeret','AR','Round','Solidity'};
nParam     = numel(paramNames);

stats = struct();

for d = 1:nDiam
    vals = struct();
    for p = 1:nParam
        vals.(paramNames{p}) = nan(1, nThresh);
    end

    for t = 1:nThresh
        S = rawData{d,t};
        for p = 1:nParam
            v = S.(paramNames{p});
            if ~isempty(v) && ~all(isnan(v))
                vals.(paramNames{p})(t) = mean(v, 'omitnan');
            end
        end
    end

    for p = 1:nParam
        stats(d).(['mean' paramNames{p}]) = mean(vals.(paramNames{p}), 'omitnan');
        stats(d).(['std'  paramNames{p}]) = std( vals.(paramNames{p}), 0, 'omitnan');
        stats(d).(['raw'  paramNames{p}]) = vals.(paramNames{p});
    end

    % Derived parameter: Diameter Difference = Feret - MinFeret
    stats(d).meanDiamDiff = stats(d).meanFeret - stats(d).meanMinFeret;
    stats(d).stdDiamDiff  = sqrt(stats(d).stdFeret^2 + stats(d).stdMinFeret^2);
    stats(d).rawDiamDiff  = vals.Feret - vals.MinFeret;

    fprintf('  Hole %s mm — mean Circularity = %.4f ± %.4f\n', ...
        diamLabels{d}, stats(d).meanCirc, stats(d).stdCirc);
end

